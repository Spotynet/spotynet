# Copy to deploy.env (gitignored) on builder and prod hosts.
#   cp deploy.env.example deploy.env
#
# Non-secret ECR / deploy config only. Do NOT put AWS access keys here —
# use an EC2 instance role (or ambient AWS creds) for ECR push/pull.

AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Derived automatically if unset:
# SPOTYNET_IMAGE_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/apps/spotynet
# Optional overrides:
# SPOTYNET_IMAGE_PREFIX=apps/spotynet
# SPOTYNET_IMAGE_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com/apps/spotynet

# deploy.sh default floating tag = git default branch (this repo: main)
SPOTYNET_IMAGE_TAG=main

# Optional domain override for deploy.sh (space-separated server_name)
# SPOTYNET_WEB_HOST=spotynet.com www.spotynet.com
